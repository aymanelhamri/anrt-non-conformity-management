# Copier dans .env (ignoré par Git), puis générer une clé en PHP :
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SECRET_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=anrt_qualite
MYSQL_USER=anrt_app
MYSQL_PASSWORD=
# Facultatif : certificat d'autorité pour MySQL distant (TLS vérifié).
MYSQL_SSL_CA=
APP_TIMEZONE=Africa/Casablanca
SESSION_COOKIE_SECURE=true
# Facultatif : dossier privé de sessions, partagé par les workers locaux.
# Vide = instance/sessions ; ne jamais placer ce dossier dans public/.
SESSION_PATH=
# Démonstration seulement, jamais activée implicitement.
DEMO_MODE=false
# Hors démonstration : fixer après confirmation D14. Seul matricule est supporté.
LOGIN_IDENTIFIER=
# Après validation D03/D04/D07 ; sinon la création reste bloquée.
NC_INITIAL_RULES_CONFIRMED=false
NC_DEADLINE_REQUIRED=false
# JSON externe de permissions approuvées ; absent = aucun droit métier.
PERMISSIONS_FILE=
